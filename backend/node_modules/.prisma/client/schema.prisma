datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  phoneNumber  String   @unique @map("phone_number")
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         String   @default("PATIENT") // PATIENT, CLINICIAN, ADMIN
  languagePref String   @default("EN") @map("language_pref") // EN, LG
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  appointments        Appointment[]
  medicationReminders MedicationReminder[]

  @@map("users")
}

model Clinic {
  id            String   @id @default(uuid())
  name          String
  location      String
  department    String   @default("General Outpatient")
  dailyCapacity Int      @default(100) @map("daily_capacity")
  openTime      String   @default("08:00") @map("open_time")
  closeTime     String   @default("17:00") @map("close_time")
  createdAt     DateTime @default(now()) @map("created_at")

  slots        AppointmentSlot[]
  appointments Appointment[]

  @@map("clinics")
}

model AppointmentSlot {
  id          String   @id @default(uuid())
  clinicId    String   @map("clinic_id")
  slotDate    String   @map("slot_date") // Format: YYYY-MM-DD
  startTime   String   @map("start_time") // Format: HH:mm (e.g. 08:00)
  endTime     String   @map("end_time") // Format: HH:mm (e.g. 09:00)
  maxPatients Int      @default(10) @map("max_patients")
  bookedCount Int      @default(0) @map("booked_count")
  version     Int      @default(0) // Optimistic locking
  createdAt   DateTime @default(now()) @map("created_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([clinicId, slotDate, startTime])
  @@map("appointment_slots")
}

model Appointment {
  id               String   @id @default(uuid())
  bookingReference String   @unique @map("booking_reference") // e.g. OBL-9482
  patientId        String   @map("patient_id")
  clinicId         String   @map("clinic_id")
  slotId           String   @map("slot_id")
  bookingChannel   String   @default("USSD") @map("booking_channel") // ANDROID, USSD, WEB
  status           String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  notes            String?
  reminderSent     Boolean  @default(false) @map("reminder_sent")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  patient             User                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic              Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  slot                AppointmentSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  medicationReminders MedicationReminder[]

  @@map("appointments")
}

model MedicationReminder {
  id             String   @id @default(uuid())
  appointmentId  String?  @map("appointment_id")
  patientId      String   @map("patient_id")
  medicationName String   @map("medication_name")
  dosage         String // e.g. "1 tablet daily after breakfast"
  reminderDate   String   @map("reminder_date") // Format: YYYY-MM-DD
  reminderTime   String   @default("08:00") @map("reminder_time") // Format: HH:mm
  channel        String   @default("SMS") // SMS, PUSH
  sentStatus     String   @default("PENDING") @map("sent_status") // PENDING, SENT, FAILED
  language       String   @default("EN") // EN, LG
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patient     User         @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medication_reminders")
}

model USSDSession {
  sessionId    String   @id @map("session_id")
  phoneNumber  String   @map("phone_number")
  currentState String   @default("INITIAL") @map("current_state")
  tempData     String?  @map("temp_data") // JSON serialized context
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("ussd_sessions")
}

model SMSLog {
  id          String   @id @default(uuid())
  phoneNumber String   @map("phone_number")
  message     String
  status      String   @default("SENT")
  providerId  String?  @map("provider_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("sms_logs")
}
